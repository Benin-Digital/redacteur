APP_NAME=Agent_IA_Redaction_Web
APP_KEY=
APP_ENV=production
APP_DEBUG=false
APP_URL=https://redacteur.benin-digital.app/api
APP_FRONTEND_URL=https://redacteur.benin-digital.app

# Sécurité des sessions
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# CORS sécurisé
CORS_ALLOWED_ORIGINS=https://redacteur.benin-digital.app
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With

# Fuseau horaire pour le Bénin (UTC+1)
APP_TIMEZONE=Africa/Porto-Novo

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR


# Configuration des logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Base de données
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agent_redaction
DB_USERNAME=redacteur_user
DB_PASSWORD=VotreAgentIAMotRedacteurDeWebPasseFortIci12345!

# Mail (configuration selon votre fournisseur)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD="mot de passe de l'application généré par Gmail"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=votre-email@gmail.com
MAIL_FROM_NAME="Redaction Web IA"

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.benin-digital.app

# Sanctum
SANCTUM_STATEFUL_DOMAINS=redacteur.benin-digital.app,localhost,localhost:4200,127.0.0.1,127.0.0.1:4200

# Serveur PHP
PHP_CLI_SERVER_WORKERS=4

# Bcrypt
BCRYPT_ROUNDS=12

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# TikTok (si utilisé)
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# TIKTOK_REDIRECT_URI=https://redacteur.benin-digital.app/api/social/tiktok/callback

# Instagram (si utilisé)
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=https://redacteur.benin-digital.app/api/social/instagram/callback